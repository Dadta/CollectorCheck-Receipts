# Runtime environment label in status responses and startup output.
NODE_ENV=production
# Local HTTP port for the continuity runtime.
PORT_RUNTIME=4000
# Local HTTP port for the web dashboard.
PORT_DASHBOARD=4100
# file stores completed runs and JSON-line logs; memory keeps logs in this process only.
PERSISTENCE_MODE=file
# info enables event logging and health checks; off disables them.
LOG_LEVEL=info
# Optional: set a private writable path for completed runtime runs.
# CONTINUITY_STATE_FILE=C:/continuity-data/runtime.json
# Optional: override the default deploy/logs/runtime.log path.
# CONTINUITY_LOG_FILE=C:/continuity-data/runtime.log